{
  "swagger": "2.0",
  "info": {
    "title": "Asana NF Integration MCP",
    "description": "Connect to the NF 3PL Integrations Asana project for live task management, search, and updates via Model Context Protocol.",
    "version": "1.0.0"
  },
  "host": "mcp.asana.com",
  "basePath": "/",
  "schemes": ["https"],
  "paths": {
    "/v2/mcp": {
      "post": {
        "operationId": "InvokeServer",
        "summary": "Asana NF Integration MCP",
        "description": "Streamable HTTP MCP endpoint hosted by Asana.",
        "x-ms-agentic-protocol": "mcp-streamable-1.0",
        "responses": {
          "200": { "description": "Immediate response" }
        }
      }
    }
  },
  "securityDefinitions": {
    "oauth2_auth": {
      "type": "oauth2",
      "flow": "accessCode",
      "tokenUrl": "https://app.asana.com/-/oauth_token",
      "authorizationUrl": "https://app.asana.com/-/oauth_authorize",
      "scopes": {}
    }
  },
  "security": [{ "oauth2_auth": [] }]
}
