{
  "mcpServers": {
    "navia-mcp": {
      "type": "http",
      "url": "https://navia-mcp.naviafreight.com/mcp",
      "headers": {
        "CF-Access-Client-Id": "${NAVIA_CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${NAVIA_CF_ACCESS_CLIENT_SECRET}",
        "Authorization": "Bearer ${NAVIA_MCP_BEARER}"
      }
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    }
  }
}
